[Unit]
Description=wishmastercave.com static site (loopback only)
After=network.target

[Service]
Type=exec
ExecStartPre=/usr/sbin/nginx -t -q -e stderr -c /etc/wishmastercave/nginx.conf
ExecStart=/usr/sbin/nginx -e stderr -c /etc/wishmastercave/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
Restart=on-failure
RestartSec=5s

DynamicUser=yes
RuntimeDirectory=wishmastercave-web
RuntimeDirectoryMode=0700
UMask=0077
LimitNOFILE=4096

# No network beyond loopback: a compromised worker cannot reach out or scan the LAN.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_UNIX

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/run/media -/media -/mnt -/run/user -/run/tailscale
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
